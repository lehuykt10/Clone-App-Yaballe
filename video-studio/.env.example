# fal.ai — one key for Seedance, TTS (ElevenLabs), Whisper. https://fal.ai/dashboard/keys
FAL_KEY=
# Anthropic — Claude analyses the reference video and writes the storyboard. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model used for storyboard writing
CLAUDE_MODEL=claude-opus-5
# Where projects (uploads, clips, final videos) are stored
DATA_DIR=./data
# How many video clips to generate in parallel on fal
MAX_PARALLEL_GENERATIONS=2
# 1 = no API calls: fake storyboard + ffmpeg test clips (free, for trying the UI)
DEMO_MODE=0
