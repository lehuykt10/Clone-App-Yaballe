                "description": {
                    "type": "description",
                    "settings": {}
                },
                "tab-pet": {
                    "type": "collapsible_tab",
                    "settings": {
                        "heading": "Pet size & weight",
                        "icon": "paw_print",
                        "content": "<p>Fits cats and small dogs up to about <strong>6 kg (13 lb)</strong> that sit comfortably in the pouch, supported by your arms.</p><p>Bigger or very wriggly pets may prefer a lap cuddle instead.</p>"
                    }
                },
                "tab-safe": {
                    "type": "collapsible_tab",
                    "settings": {
                        "heading": "Safe cuddles",
                        "icon": "check_mark",
                        "content": "<ul><li>Always support your pet from below with your arms. The pouch is for cuddles, not hands-free carrying.</li><li>Don't use it while driving, cycling, cooking or doing anything where your pet could get hurt.</li><li>Start with a few minutes at home and let your pet climb out whenever they want. Never leave them in the pouch unattended or in the heat.</li></ul>"
                    }
                },
                "tab-care": {
                    "type": "collapsible_tab",
                    "settings": {
                        "heading": "Care",
                        "icon": "washing",
                        "content": "<p>Turn inside out. Machine wash cold on a gentle cycle. Air-dry flat. Don't tumble dry, bleach or iron.</p>"
                    }
                },
                "tab-ship": {
                    "type": "collapsible_tab",
                    "settings": {
                        "heading": "Shipping & Christmas delivery",
                        "icon": "truck",
                        "content": "<p>Free tracked shipping worldwide. US orders usually arrive in 9–17 days; Canada, the UK and Australia in 10–20 days; most other countries in 12–25 days. All taxes and import duties are included.</p><p><strong>For Christmas:</strong> order by December 5 (US), December 2 (Canada, UK, Australia) or November 28 (other countries). <a href=\"/pages/shipping-policy\">Full shipping policy</a></p>"
                    }
                },
                "tab-guarantee": {
                    "type": "collapsible_tab",
                    "settings": {
                        "heading": "Our guarantee",
                        "icon": "heart",
                        "content": "<p>If it arrives damaged or faulty, send a photo to support@suzeno.com within 30 days and we'll refund you or send a replacement. Wrong size? Email us and we'll help.</p>"
                    }
                },
                "size-guide": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "<div class=\"product__accordion accordion\"><details><summary><div class=\"summary__title\">{% render 'icon-accordion', icon: 'ruler' %}<h2 class=\"h4 accordion__title\">Size guide</h2></div>{{- 'icon-caret.svg' | inline_asset_content -}}</summary><div class=\"accordion__content rte\" id=\"size-guide\"><p>Relaxed, roomy fit to make room for your pet. Between sizes or carrying a bigger pet? Size up.</p><p><strong>Garment measurements</strong> (may vary by 1–3 cm / 0.5–1 in)</p><div style=\"overflow-x:auto\"><table><thead><tr><th>Size</th><th>Chest (around)</th><th>Length</th><th>Sleeve</th></tr></thead><tbody><tr><td>S</td><td>112 cm / 44.1 in</td><td>74 cm / 29.1 in</td><td>63 cm / 24.8 in</td></tr><tr><td>M</td><td>118 cm / 46.5 in</td><td>75 cm / 29.5 in</td><td>64 cm / 25.2 in</td></tr><tr><td>L</td><td>124 cm / 48.8 in</td><td>76 cm / 29.9 in</td><td>65 cm / 25.6 in</td></tr><tr><td>XL</td><td>130 cm / 51.2 in</td><td>77 cm / 30.3 in</td><td>66 cm / 26.0 in</td></tr><tr><td>2XL</td><td>136 cm / 53.5 in</td><td>78 cm / 30.7 in</td><td>67 cm / 26.4 in</td></tr><tr><td>3XL</td><td>142 cm / 55.9 in</td><td>79 cm / 31.1 in</td><td>68 cm / 26.8 in</td></tr></tbody></table></div><p>Tip: lay a hoodie you love flat, measure across the chest and double it, then compare with the chest column.</p></div></details></div>"
                    }
                }
            },
