                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "{%- if shop.enabled_payment_types.size > 0 -%}<ul class=\"suzeno-pay\" role=\"list\">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul><style>.suzeno-pay{display:flex;flex-wrap:wrap;gap:0.6rem;justify-content:center;list-style:none;margin:0.4rem 0 0.8rem;padding:0}.suzeno-pay svg{height:2.4rem;width:3.8rem}</style>{%- endif -%}"
                    }
