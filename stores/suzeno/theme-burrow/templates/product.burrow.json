                "pitch": {
                    "type": "text",
                    "settings": {
                        "text": "Plush sherpa-style fleece outside, a zip-up pouch up front, and your little one snuggled right where they love to be: with you.",
                        "text_style": "body"
                    }
                },
                "xmas": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "{%- liquid\n  assign cc = localization.country.iso_code\n  assign key = ',' | append: cc | append: ','\n  assign cut = '-11-28'\n  if cc == 'US'\n    assign cut = '-12-05'\n  elsif ',CA,GB,AU,' contains key\n    assign cut = '-12-02'\n  endif\n  assign cut_date = 'now' | date: '%Y' | append: cut\n  assign cut_s = cut_date | append: ' 23:59:59' | date: '%s' | plus: 0\n  assign now_s = 'now' | date: '%s' | plus: 0\n  assign left = cut_s | minus: now_s | divided_by: 86400 | plus: 1\n  assign slow = false\n  if ',DZ,AO,BJ,BW,BF,BI,CM,CV,CF,TD,KM,CG,CD,CI,DJ,EG,GQ,ER,SZ,ET,GA,GM,GH,GN,GW,KE,LS,LR,LY,MG,MW,ML,MR,MU,YT,MA,MZ,NA,NE,NG,RE,RW,SH,ST,SN,SC,SL,SO,ZA,SS,SD,TZ,TG,TN,UG,EH,ZM,ZW,AC,TA,IO,TF,AR,BO,BR,CL,CO,EC,FK,GF,GY,PY,PE,SR,UY,VE,GS,' contains key\n    assign slow = true\n  endif\n-%}{%- if cut_s > now_s and slow == false -%}<p class=\"suzeno-xmas\">🎄 Order by <strong>{{ cut_date | date: '%B %-d' }}</strong> for Christmas delivery to {{ localization.country.name }}{%- if left <= 14 %} · only {{ left }} day{% if left > 1 %}s{% endif %} left{% endif -%}</p><style>.suzeno-xmas{background:#F3E9E4;border-radius:.8rem;padding:.8rem 1.2rem;margin:.4rem 0 1rem;font-size:1.4rem;text-align:center}</style>{%- endif -%}"
                    }
                },
                "bundle": {
                    "type": "bundle_picker",
                    "settings": {
                        "heading": "Choose your bundle",
                        "default_tier": 1,
                        "tier_1_qty": 1,
                        "tier_1_discount": 0,
                        "tier_1_label": "1 Hoodie",
                        "tier_1_sublabel": "Cozy cuddles all winter",
                        "tier_1_badge": "",
                        "tier_1_perks": "Free worldwide shipping · Taxes included",
                        "tier_2_qty": 2,
                        "tier_2_discount": 5,
                        "tier_2_label": "2 Hoodies",
                        "tier_2_sublabel": "One for you, one to gift",
                        "tier_2_badge": "Gift pick",
                        "tier_2_perks": "Free worldwide shipping · Save $10",
                        "tier_3_qty": 0,
                        "tier_3_discount": 0,
                        "tier_3_label": "",
                        "tier_3_sublabel": "",
                        "tier_3_badge": "",
                        "tier_3_perks": ""
