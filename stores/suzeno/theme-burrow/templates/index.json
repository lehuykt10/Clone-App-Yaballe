{
    "sections": {
        "hero": {
            "type": "image-with-text",
            "blocks": {
                "h": {
                    "type": "heading",
                    "settings": {
                        "heading": "Your pet, closer.",
                        "heading_size": "h0"
                    }
                },
                "t": {
                    "type": "text",
                    "settings": {
                        "text": "<p>The Burrow Hoodie: plush fleece with a front pouch for cats and small dogs. 7 colors, free worldwide shipping, taxes and duties included.</p>",
                        "text_style": "body"
                    }
                },
                "b": {
                    "type": "button",
                    "settings": {
                        "button_label": "Shop the Burrow Hoodie",
                        "button_link": "shopify://products/burrow-hoodie",
                        "button_style_secondary": false
                    }
                }
            },
            "block_order": [
                "h",
                "t",
                "b"
            ],
            "settings": {
                "image": "shopify://shop_images/burrow-hoodie-black.jpg",
                "height": "adapt",
                "desktop_image_width": "medium",
                "layout": "image_first",
                "image_behavior": "none",
                "content_layout": "no-overlap",
                "desktop_content_position": "middle",
                "desktop_content_alignment": "left",
                "mobile_content_alignment": "left",
                "section_color_scheme": "scheme-7",
                "color_scheme": "scheme-7",
                "padding_top": 24,
                "padding_bottom": 36
            }
        },
        "trust": {
            "type": "benefits-grid",
            "blocks": {
                "b-1": {
                    "type": "benefit",
                    "settings": {
                        "title": "Free worldwide shipping",
                        "text": "<p>Tracked delivery on every order.</p>"
                    }
                },
                "b-2": {
                    "type": "benefit",
                    "settings": {
                        "title": "Taxes & duties included",
                        "text": "<p>The price at checkout is the final price.</p>"
                    }
                },
                "b-3": {
                    "type": "benefit",
                    "settings": {
                        "title": "30-day guarantee",
                        "text": "<p>Damaged or not right? We'll make it right.</p>"
                    }
                },
                "b-4": {
                    "type": "benefit",
                    "settings": {
                        "title": "Friendly support",
                        "text": "<p>Real people, replies within 1 business day.</p>"
                    }
                }
            },
            "block_order": [
                "b-1",
                "b-2",
                "b-3",
                "b-4"
            ],
            "settings": {
                "heading": "",
                "heading_size": "h1",
                "columns_desktop": 4,
                "color_scheme": "scheme-1",
                "padding_top": 48,
                "padding_bottom": 48
            }
        },
        "featured": {
            "type": "featured-product",
            "blocks": {
                "title": {
                    "type": "title",
                    "settings": {
                        "heading_size": "h1"
                    }
                },
                "summary": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "{% render 'review-summary', product: section.settings.product %}"
                    }
                },
                "price": {
                    "type": "price",
                    "settings": {}
                },
                "text": {
                    "type": "text",
                    "settings": {
                        "text": "Plush sherpa-style fleece outside, a cozy pouch up front, and your little one snuggled right where they love to be: with you.",
                        "text_style": "body"
                    }
                },
                "xmas": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "{%- liquid\n  assign cc = localization.country.iso_code\n  assign key = ',' | append: cc | append: ','\n  assign cut = '-11-28'\n  if cc == 'US'\n    assign cut = '-12-05'\n  elsif ',CA,GB,AU,' contains key\n    assign cut = '-12-02'\n  endif\n  assign cut_date = 'now' | date: '%Y' | append: cut\n  assign cut_s = cut_date | append: ' 23:59:59' | date: '%s' | plus: 0\n  assign now_s = 'now' | date: '%s' | plus: 0\n  assign left = cut_s | minus: now_s | divided_by: 86400 | plus: 1\n  assign slow = false\n  if ',DZ,AO,BJ,BW,BF,BI,CM,CV,CF,TD,KM,CG,CD,CI,DJ,EG,GQ,ER,SZ,ET,GA,GM,GH,GN,GW,KE,LS,LR,LY,MG,MW,ML,MR,MU,YT,MA,MZ,NA,NE,NG,RE,RW,SH,ST,SN,SC,SL,SO,ZA,SS,SD,TZ,TG,TN,UG,EH,ZM,ZW,AC,TA,IO,TF,AR,BO,BR,CL,CO,EC,FK,GF,GY,PY,PE,SR,UY,VE,GS,' contains key\n    assign slow = true\n  endif\n-%}{%- if cut_s > now_s and slow == false -%}<p class=\"suzeno-xmas\">🎄 Order by <strong>{{ cut_date | date: '%B %-d' }}</strong> for Christmas delivery to {{ localization.country.name }}{%- if left <= 14 %} · only {{ left }} day{% if left > 1 %}s{% endif %} left{% endif -%}</p><style>.suzeno-xmas{background:#F3E9E4;border-radius:.8rem;padding:.8rem 1.2rem;margin:.4rem 0 1rem;font-size:1.4rem;text-align:center}</style>{%- endif -%}"
                    }
                },
                "variant_picker": {
                    "type": "variant_picker",
                    "settings": {
                        "picker_type": "button",
                        "swatch_shape": "circle"
                    }
                },
                "buy_buttons": {
                    "type": "buy_buttons",
                    "settings": {
                        "show_dynamic_checkout": false
                    }
                },
                "timeline": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "{% render 'delivery-timeline' %}"
                    }
                },
                "more": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "<p style=\"text-align:center;margin:.6rem 0 0\"><a href=\"{{ section.settings.product.url }}\">See all details &amp; bundle deal →</a></p>"
                    }
                }
            },
            "block_order": [
                "title",
                "summary",
                "price",
                "text",
                "xmas",
                "variant_picker",
                "buy_buttons",
                "timeline",
                "more"
            ],
            "settings": {
                "product": "burrow-hoodie",
                "color_scheme": "scheme-1",
