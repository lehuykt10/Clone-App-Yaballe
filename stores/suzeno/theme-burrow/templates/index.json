        "faq": {
            "type": "faq-accordion",
            "blocks": {
                "q-1": {
                    "type": "question",
                    "settings": {
                        "question": "How does the pet pouch work?",
                        "answer": "<p>Your pet climbs into the roomy front pouch and pops their head out through the round, soft-edged opening, while you support them from below with your arms.</p>"
                    }
                },
                "q-2": {
                    "type": "question",
                    "settings": {
                        "question": "What size should I choose?",
                        "answer": "<p>Pick your usual size: the fit is relaxed to make room for your pet. Between sizes? Size up. Not sure? Email support@suzeno.com with your height and usual size and we'll help.</p>"
                    }
                },
                "q-3": {
                    "type": "question",
                    "settings": {
                        "question": "Will it arrive before Christmas?",
                        "answer": "<p>Order by December 5 for the US, December 2 for Canada, the UK and Australia, and November 28 for other countries. US orders usually arrive in 9–17 days; Canada, the UK and Australia in 10–20 days; most other countries in 12–25 days.</p>"
                    }
                },
                "q-4": {
                    "type": "question",
                    "settings": {
                        "question": "Will I pay customs fees or taxes?",
                        "answer": "<p>No. Our prices include all taxes and import duties, so the price at checkout is the final price. If a carrier ever asks you for a fee, contact us before paying and we'll take care of it.</p>"
                    }
                },
                "q-5": {
                    "type": "question",
                    "settings": {
                        "question": "What if it doesn't fit or arrives damaged?",
                        "answer": "<p>Contact support@suzeno.com within 30 days of delivery. If it arrives damaged or faulty, we'll refund you or send a replacement. For a different size, email us and we'll help.</p>"
                    }
                }
            },
            "block_order": [
                "q-1",
                "q-2",
                "q-3",
                "q-4",
                "q-5"
            ],
