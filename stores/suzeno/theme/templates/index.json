            "settings": {
                "desktop_content_position": "center",
                "content_alignment": "center",
                "color_scheme": "scheme-1",
                "full_width": true,
                "padding_top": 48,
                "padding_bottom": 48
            }
        },
        "faq": {
            "type": "faq-accordion",
            "blocks": {
                "q-1": {
                    "type": "question",
                    "settings": {
                        "question": "How long does shipping take?",
                        "answer": "<p>Shipping is free worldwide. Orders to the US usually arrive in 9–17 days, Canada, the UK and Australia in 10–20 days, and most other countries in 12–25 days. You'll get a tracking link by email.</p>"
                    }
                },
                "q-2": {
                    "type": "question",
                    "settings": {
                        "question": "Will I pay customs fees or taxes?",
                        "answer": "<p>No. Our prices include all taxes and import duties, so the price at checkout is the final price. If a carrier ever asks you for a fee, contact us before paying and we'll take care of it.</p>"
                    }
                },
                "q-3": {
                    "type": "question",
                    "settings": {
                        "question": "How do I track my order?",
                        "answer": "<p>Use the tracking link in your shipping confirmation email, or visit our <a href=\"/pages/track-order\">Track your order</a> page.</p>"
                    }
                },
                "q-4": {
                    "type": "question",
                    "settings": {
                        "question": "What if my order arrives damaged?",
                        "answer": "<p>Send a photo to support@suzeno.com within 30 days of delivery and we'll send a replacement or refund you.</p>"
                    }
                },
                "q-5": {
                    "type": "question",
                    "settings": {
                        "question": "Can I return an item?",
                        "answer": "<p>Yes. Contact us within 30 days of delivery and we'll help. See our <a href=\"/pages/refund-policy\">Refund policy</a>.</p>"
                    }
                },
                "q-6": {
                    "type": "question",
                    "settings": {
                        "question": "How can I contact you?",
                        "answer": "<p>Email support@suzeno.com. We reply within 1 business day.</p>"
                    }
                }
            },
            "block_order": [
                "q-1",
                "q-2",
                "q-3",
                "q-4",
                "q-5",
                "q-6"
            ],
            "settings": {
                "heading": "Good to know",
                "heading_size": "h1",
                "open_first": true,
                "color_scheme": "scheme-2",
                "padding_top": 48,
                "padding_bottom": 48
