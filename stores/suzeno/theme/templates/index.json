        "welcome_code": {
            "type": "custom-liquid",
            "settings": {
                "custom_liquid": "<script>document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.newsletter-form__message--success').forEach(function(el){el.insertAdjacentHTML('afterend','<p class=\"suzeno-welcome\">Your 10% off code: <strong>WELCOME10</strong><br>Enter it at checkout on your first order.</p>');});});</script><style>.suzeno-welcome{margin:1rem auto 0;padding:1rem 1.6rem;border:2px dashed currentColor;border-radius:1rem;max-width:36rem;text-align:center;font-size:1.6rem}</style>",
                "color_scheme": "scheme-3",
                "padding_top": 0,
                "padding_bottom": 0
            }
        },
        "hoodie": {
            "type": "featured-product",
            "blocks": {
                "title": {
                    "type": "title",
                    "settings": {
                        "heading_size": "h1"
                    }
                },
                "price": {
                    "type": "price",
                    "settings": {}
                },
                "text": {
                    "type": "text",
                    "settings": {
                        "text": "Cat pouch hoodie · 4 festive designs · Sizes XXS–XXL · Buy 2, save $10",
                        "text_style": "body"
                    }
                },
                "xmas": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "{%- liquid\n  assign cc = localization.country.iso_code\n  assign key = ',' | append: cc | append: ','\n  assign cut = '-11-28'\n  if cc == 'US'\n    assign cut = '-12-05'\n  elsif ',CA,GB,AU,' contains key\n    assign cut = '-12-02'\n  endif\n  assign cut_date = 'now' | date: '%Y' | append: cut\n  assign cut_s = cut_date | append: ' 23:59:59' | date: '%s' | plus: 0\n  assign now_s = 'now' | date: '%s' | plus: 0\n  assign left = cut_s | minus: now_s | divided_by: 86400 | plus: 1\n  assign slow = false\n  if ',DZ,AO,BJ,BW,BF,BI,CM,CV,CF,TD,KM,CG,CD,CI,DJ,EG,GQ,ER,SZ,ET,GA,GM,GH,GN,GW,KE,LS,LR,LY,MG,MW,ML,MR,MU,YT,MA,MZ,NA,NE,NG,RE,RW,SH,ST,SN,SC,SL,SO,ZA,SS,SD,TZ,TG,TN,UG,EH,ZM,ZW,AC,TA,IO,TF,AR,BO,BR,CL,CO,EC,FK,GF,GY,PY,PE,SR,UY,VE,GS,' contains key\n    assign slow = true\n  endif\n-%}{%- if cut_s > now_s and slow == false -%}<p class=\"suzeno-xmas\">🎄 Order by <strong>{{ cut_date | date: '%B %-d' }}</strong> for Christmas delivery to {{ localization.country.name }}{%- if left <= 14 %} · only {{ left }} day{% if left > 1 %}s{% endif %} left{% endif -%}</p><style>.suzeno-xmas{background:#F3E9E4;border-radius:.8rem;padding:.8rem 1.2rem;margin:.4rem 0 1rem;font-size:1.4rem;text-align:center}</style>{%- endif -%}"
                    }
                },
                "cta": {
                    "type": "custom_liquid",
                    "settings": {
                        "custom_liquid": "{%- assign scope = '#shopify-section-' | append: section.id -%}{%- render 'media-ratio', product: section.settings.product, scope: scope -%}<a class=\"button button--full-width\" href=\"{{ section.settings.product.url }}\">Choose design & size</a>"
                    }
                }
            },
            "block_order": [
                "title",
                "price",
                "text",
                "xmas",
                "cta"
            ],
            "settings": {
                "product": "cuddle-hoodie",
                "color_scheme": "scheme-1",
                "secondary_background": false,
                "media_size": "medium",
                "constrain_to_viewport": true,
                "media_fit": "cover",
                "media_position": "left",
                "image_zoom": "none",
                "hide_variants": true,
                "enable_video_looping": true,
                "padding_top": 48,
                "padding_bottom": 24
            }
        },
