        "promise": {
            "type": "rich-text",
            "blocks": {
                "h": {
                    "type": "heading",
                    "settings": {
                        "heading": "Made for the pets who make us smile",
                        "heading_size": "h1"
                    }
                },
                "t": {
                    "type": "text",
                    "settings": {
                        "text": "<p>Suzeno is a small online pet shop. We choose every product for real everyday moments: play time, quiet time and the memories in between. Every order ships free worldwide with tracking, all taxes and duties are included, and if something isn't right, we'll make it right within 30 days.</p>"
                    }
                }
            },
            "block_order": [
