{%- comment -%}
  "Us vs typical alternatives" comparison. Never name a real competitor.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="compare page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="{{ section.settings.heading_size }} center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="compare__scroll">
      <table class="compare__table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="compare__us">{{ section.settings.us_label }}</th>
            <th scope="col">{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td class="compare__us">
                {%- if block.settings.us -%}
                  <span class="compare__yes" aria-label="Yes">✓</span>
                {%- else -%}
                  <span class="compare__no" aria-label="No">✕</span>
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.them -%}
                  <span class="compare__yes" aria-label="Yes">✓</span>
                {%- else -%}
                  <span class="compare__no" aria-label="No">✕</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .compare__scroll { margin-top: 2.4rem; overflow-x: auto; }
  .compare__table { border-collapse: collapse; width: 100%; }
  .compare__table th,
  .compare__table td {
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
    padding: 1.4rem 1rem;
    text-align: center;
  }
  .compare__table tbody th { font-weight: 500; text-align: left; }
  .compare__table thead th { font-weight: 700; }
  .compare__us { background: rgba(var(--color-button), 0.08); }
  thead .compare__us { border-radius: 1rem 1rem 0 0; color: rgb(var(--color-button)); }
  .compare__yes { color: rgb(var(--color-button)); font-size: 2rem; font-weight: 700; }
  .compare__no { font-size: 1.8rem; opacity: 0.4; }
{%- endstyle -%}

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Why pet parents switch" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "text", "id": "us_label", "label": "Our column", "default": "Us" },
    { "type": "text", "id": "them_label", "label": "Other column", "default": "Regular carrier" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
        { "type": "checkbox", "id": "us", "label": "We have it", "default": true },
        { "type": "checkbox", "id": "them", "label": "They have it", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Comparison table", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" }] }
  ]
}
{% endschema %}
