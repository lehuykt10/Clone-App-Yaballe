{%- comment -%}
  Size guide: human size + max pet weight per size. Rows are blocks so the
  owner can edit measurements in the theme editor.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="size-guide page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="{{ section.settings.heading_size }} center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="size-guide__intro rte center">{{ section.settings.intro }}</div>
    {%- endif -%}
    <div class="size-guide__scroll">
      <table class="size-guide__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_1 }}</th>
            <th scope="col">{{ section.settings.col_2 }}</th>
            <th scope="col">{{ section.settings.col_3 }}</th>
            <th scope="col">{{ section.settings.col_4 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.size }}</th>
              <td>{{ block.settings.value_2 }}</td>
              <td>{{ block.settings.value_3 }}</td>
              <td>{{ block.settings.value_4 }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank -%}
      <div class="size-guide__note rte">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .size-guide__scroll { margin-top: 2rem; overflow-x: auto; }
  .size-guide__table { border-collapse: collapse; min-width: 48rem; width: 100%; }
  .size-guide__table th,
  .size-guide__table td {
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
    padding: 1.2rem 1rem;
    text-align: center;
  }
  .size-guide__table thead th { background: rgba(var(--color-foreground), 0.05); font-weight: 700; }
  .size-guide__note { font-size: 1.4rem; margin-top: 1.6rem; opacity: 0.8; }
{%- endstyle -%}

{% schema %}
{
  "name": "Size guide",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Find your size" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "col_1", "label": "Column 1 header", "default": "Size" },
    { "type": "text", "id": "col_2", "label": "Column 2 header", "default": "Chest (in)" },
    { "type": "text", "id": "col_3", "label": "Column 3 header", "default": "Length (in)" },
    { "type": "text", "id": "col_4", "label": "Column 4 header", "default": "Pet up to" },
    { "type": "richtext", "id": "note", "label": "Note below table" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Size row",
      "settings": [
        { "type": "text", "id": "size", "label": "Size", "default": "M" },
        { "type": "text", "id": "value_2", "label": "Column 2 value" },
        { "type": "text", "id": "value_3", "label": "Column 3 value" },
        { "type": "text", "id": "value_4", "label": "Column 4 value" }
      ]
    }
  ],
  "presets": [{ "name": "Size guide", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
