{%- comment -%}
  FAQ accordion with FAQPage structured data (rich results in Google).
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="faq page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading {{ section.settings.heading_size }} center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary class="faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .faq__list { margin-top: 2.4rem; }
  .faq__item { border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12); }
  .faq__question {
    align-items: center;
    cursor: pointer;
    display: flex;
    font-size: 1.7rem;
    font-weight: 600;
    gap: 1.6rem;
    justify-content: space-between;
    list-style: none;
    min-height: 4.4rem;
    padding: 1.6rem 0;
  }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__icon { flex-shrink: 0; height: 1.4rem; position: relative; width: 1.4rem; }
  .faq__icon::before,
  .faq__icon::after {
    background: currentColor;
    content: '';
    height: 0.2rem;
    left: 0;
    position: absolute;
    top: 50%;
    transition: transform 0.2s ease;
    width: 100%;
  }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__answer { padding: 0 0 1.6rem; }
{%- endstyle -%}

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Questions? We've got answers" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>A clear, short answer.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ accordion", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }
  ]
}
{% endschema %}
