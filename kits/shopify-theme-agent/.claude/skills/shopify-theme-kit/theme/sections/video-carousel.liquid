{%- comment -%}
  Kit video carousel: swipeable row of vertical clips (muted, looping) with an optional
  caption each. Add one block per video in the theme editor. Hidden on the store until at
  least one block has a video or image.
  Only call clips "customer" or "as seen on" a platform when that is true.
{%- endcomment -%}
{%- liquid
  assign has_media = false
  for block in section.blocks
    if block.settings.video != blank or block.settings.image != blank
      assign has_media = true
    endif
  endfor
-%}
{%- if has_media -%}
  <div class="vc color-{{ section.settings.color_scheme }} gradient">
    <div class="vc__inner section-{{ section.id }}-padding">
      <div class="page-width vc__head">
        <h2 class="vc__heading {{ section.settings.heading_size }}">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.highlight != blank %} <span class="vc__hl">{{ section.settings.highlight | escape }}</span>{%- endif -%}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="vc__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      <div class="vc__wrap">
        <button type="button" class="vc__nav vc__nav--prev" aria-label="Previous video">‹</button>
        <ul class="vc__track" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.video != blank or block.settings.image != blank -%}
              <li class="vc__item" {{ block.shopify_attributes }}>
                <div class="vc__media">
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '720x', class: 'vc__video' }}
                  {%- else -%}
                    {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360,540,720', sizes: '(min-width: 990px) 28vw, 68vw', class: 'vc__video' }}
                  {%- endif -%}
                  {%- if block.settings.caption != blank -%}
                    <p class="vc__caption">{{ block.settings.caption | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <button type="button" class="vc__nav vc__nav--next" aria-label="Next video">›</button>
      </div>
      <div class="vc__dots" aria-hidden="true"></div>
    </div>
  </div>
  <script>
    (function () {
      var root = document.currentScript.previousElementSibling;
      var track = root.querySelector('.vc__track');
      var items = track.querySelectorAll('.vc__item');
      var dots = root.querySelector('.vc__dots');
      items.forEach(function (_, i) { var d = document.createElement('span'); if (i === 0) d.className = 'is-on'; dots.appendChild(d); });
      function step() { return items.length ? items[0].getBoundingClientRect().width + 16 : 0; }
      root.querySelector('.vc__nav--prev').addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      root.querySelector('.vc__nav--next').addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', function () {
        var i = Math.round(track.scrollLeft / (step() || 1));
        dots.querySelectorAll('span').forEach(function (d, n) { d.classList.toggle('is-on', n === i); });
      }, { passive: true });
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { var v = e.target.querySelector('video'); if (!v) return; if (e.isIntersecting) { v.play().catch(function () {}); } else { v.pause(); } }); }, { threshold: .5 });
        items.forEach(function (it) { io.observe(it); });
      }
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding:3rem 0;text-align:center;opacity:.7">
    Video carousel: add a block per video (vertical 9:16 clips). Hidden on the store until a video is added.
  </div>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  .vc__head { text-align: center; }
  .vc__heading { margin: 0; }
  .vc__hl { background: linear-gradient(90deg, #F9A825, #E1306C 55%, #7B2FF7); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .vc__sub { margin: 1.2rem 0 0; font-size: 1.8rem; opacity: .75; }
  .vc__wrap { position: relative; margin-top: 3rem; }
  .vc__track { list-style: none; margin: 0; padding: 0 max(1.6rem, calc((100vw - 120rem) / 2)); display: flex; gap: 1.6rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .vc__track::-webkit-scrollbar { display: none; }
  .vc__item { flex: 0 0 68%; scroll-snap-align: center; }
  @media screen and (min-width: 750px) { .vc__item { flex-basis: 34%; } }
  @media screen and (min-width: 990px) { .vc__item { flex-basis: 26%; } }
  .vc__media { position: relative; aspect-ratio: 9 / 16; border-radius: 2.4rem; overflow: hidden; background: rgba(var(--color-foreground), .06); }
  .vc__video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .vc__caption { position: absolute; left: 1.2rem; right: 1.2rem; top: 18%; margin: 0; text-align: center; color: #fff; font-weight: 700; font-size: 1.5rem; line-height: 1.3; text-shadow: 0 1px 4px rgba(0, 0, 0, .6); }
  .vc__nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 4.4rem; height: 4.4rem; border-radius: 50%; border: 0; background: rgba(0, 0, 0, .55); color: #fff; font-size: 2.6rem; line-height: 1; cursor: pointer; }
  .vc__nav--prev { left: 1.2rem; }
  .vc__nav--next { right: 1.2rem; }
  .vc__dots { display: flex; justify-content: center; gap: .8rem; margin-top: 2rem; }
  .vc__dots span { width: .9rem; height: .9rem; border-radius: 50%; background: rgba(var(--color-foreground), .25); }
  .vc__dots span.is-on { background: rgb(var(--color-foreground)); }
{%- endstyle -%}

{% schema %}
{
  "name": "Video carousel",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "default": "Cozy moments,", "label": "Heading" },
    { "type": "text", "id": "highlight", "default": "caught on camera", "label": "Heading: gradient words" },
    { "type": "select", "id": "heading_size", "default": "h1", "label": "Heading size",
      "options": [ { "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" } ] },
    { "type": "text", "id": "subheading", "default": "Snuggles, naps and peek-a-boo moments.", "label": "Subheading" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48, "label": "Bottom padding" }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (vertical 9:16, 5–20 s)" },
        { "type": "image_picker", "id": "image", "label": "Or image", "info": "Used when no video is chosen." },
        { "type": "text", "id": "caption", "label": "Caption on top (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "Video carousel", "blocks": [ { "type": "clip" }, { "type": "clip" }, { "type": "clip" } ] } ]
}
{% endschema %}
