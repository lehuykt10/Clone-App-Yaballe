{%- comment -%}
  Bundle picker / quantity breaks for main-product ("Buy 1 / Buy 2 / Buy 3").
  Works for any niche.

  - Each tier adds N units. Every unit gets its own variant picker (colour,
    size or any option), so a buyer can mix variants inside one bundle.
  - On submit it adds one cart line per variant via /cart/add.js, then
    refreshes Dawn's cart drawer (cart_type = drawer), or opens /cart.
  - Displayed price = regular price minus the tier discount: a fixed amount
    off each unit, or a percent off the tier total ("Discount type").
    The SAME discount must exist in Shopify as an automatic discount,
    otherwise the cart charges full price. Run /du-lieu-store to create it.
  - Colour chips come from Shopify's native swatches or the name map in
    snippets/bundle-picker-color.liquid; other options show no chip.

  Params: block, product, product_form_id, section_id
{%- endcomment -%}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign price = current.price
  assign default_tier = block.settings.default_tier
  assign percent_mode = false
  if block.settings.discount_type == 'percent'
    assign percent_mode = true
  endif
-%}

<bundle-picker
  class="bundle-picker"
  data-form="{{ product_form_id }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="bundle-picker__heading"><span>{{ block.settings.heading }}</span></p>
  {%- endif -%}

  <fieldset class="bundle-picker__tiers">
    <legend class="visually-hidden">{{ block.settings.heading | default: 'Choose your set' | strip_html }}</legend>

    {%- for i in (1..3) -%}
      {%- liquid
        assign prefix = 'tier_' | append: i | append: '_'
        assign qty_key = prefix | append: 'qty'
        assign off_key = prefix | append: 'discount'
        assign label_key = prefix | append: 'label'
        assign sublabel_key = prefix | append: 'sublabel'
        assign badge_key = prefix | append: 'badge'
        assign perks_key = prefix | append: 'perks'
        assign qty = block.settings[qty_key]
        if qty == 0
          continue
        endif
        assign full = price | times: qty
        if percent_mode
          assign saved = full | times: block.settings[off_key] | divided_by: 100.0 | round
        else
          assign saved = block.settings[off_key] | times: 100 | times: qty
        endif
        assign off = saved
        assign total = full | minus: saved
      -%}
      <div class="bundle-picker__tier" data-tier data-qty="{{ qty }}" data-off="{{ off }}" data-total-text="{{ total | money | escape }}">
        <label class="bundle-picker__head">
          <input
            type="radio"
            name="bundle-tier-{{ section_id }}"
            value="{{ qty }}"
            {% if i == default_tier %}
              checked
            {% endif %}
          >
          <span class="bundle-picker__titles">
            <span class="bundle-picker__label">{{ block.settings[label_key] }}</span>
            {%- if block.settings[sublabel_key] != blank -%}
              <span class="bundle-picker__sublabel">{{ block.settings[sublabel_key] }}</span>
            {%- endif -%}
          </span>
          <span class="bundle-picker__prices">
            <span class="bundle-picker__total" data-total>{{ total | money }}</span>
            {%- if off > 0 -%}
              <s class="bundle-picker__full" data-full>{{ full | money }}</s>
              <span class="bundle-picker__save">{{ block.settings.save_label | default: 'Save' }} {{ saved | money }}</span>
            {%- endif -%}
          </span>
          {%- if block.settings[badge_key] != blank -%}
            <span class="bundle-picker__badge">{{ block.settings[badge_key] }}</span>
          {%- endif -%}
        </label>

        <div class="bundle-picker__body">
          {%- if product.has_only_default_variant == false -%}
            <p class="bundle-picker__option-name">{{ product.options.first }}</p>
            {%- for n in (1..qty) -%}
              <div class="bundle-picker__unit" data-unit>
                {%- if qty > 1 -%}
                  <span class="bundle-picker__unit-label">#{{ n }}</span>
                {%- endif -%}
                <div class="bp-select" data-select>
                  <button
                    type="button"
                    class="bp-select__button"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label="{{ product.options.first | escape }}{% if qty > 1 %} {{ n }}{% endif %}"
                  >
                    {%- capture chip -%}{%- render 'bundle-picker-color', variant: current -%}{%- endcapture -%}
                    <span class="bp-chip" data-chip style="--chip: {{ chip }}"{% if chip == blank %} hidden{% endif %}></span>
                    <span data-name>{{ current.title }}</span>
                    <span class="bp-select__caret" aria-hidden="true"></span>
                  </button>
                  <div class="bp-select__list" role="radiogroup" hidden>
                    {%- for variant in product.variants -%}
                      {%- capture chip -%}{%- render 'bundle-picker-color', variant: variant -%}{%- endcapture -%}
                      <label class="bp-select__option{% unless variant.available %} is-disabled{% endunless %}">
                        <input
                          type="radio"
                          name="bundle-{{ section_id }}-{{ i }}-{{ n }}"
                          value="{{ variant.id }}"
                          data-color="{{ chip }}"
                          {% if variant.id == current.id %}
                            checked
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                        {%- if chip != blank -%}
                          <span class="bp-chip" style="--chip: {{ chip }}"></span>
                        {%- endif -%}
                        <span>{{ variant.title }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
          {%- if block.settings[perks_key] != blank -%}
            <p class="bundle-picker__perks">{{ block.settings[perks_key] }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </fieldset>
</bundle-picker>

{%- style -%}
  .bundle-picker { margin: 1.6rem 0 0.8rem; }
  .bundle-picker__heading {
    align-items: center;
    display: flex;
    font-size: 1.3rem;
    font-weight: 700;
    gap: 1.2rem;
    letter-spacing: 0.08rem;
    margin: 0 0 1.2rem;
    text-transform: uppercase;
  }
  .bundle-picker__heading::before,
  .bundle-picker__heading::after { background: rgba(var(--color-foreground), 0.2); content: ''; flex: 1; height: 0.1rem; }
  .bundle-picker__tiers { border: 0; display: grid; gap: 1.2rem; margin: 0; padding: 0; }
  .bundle-picker__tier {
    background: rgb(var(--color-background));
    border: 0.15rem solid rgba(var(--color-foreground), 0.18);
    border-radius: 1.4rem;
    position: relative;
  }
  .bundle-picker__tier.is-active { border-color: rgb(var(--color-button)); box-shadow: 0 0 0 0.1rem rgb(var(--color-button)); }
  .bundle-picker__head { align-items: center; cursor: pointer; display: flex; gap: 1.2rem; min-height: 4.8rem; padding: 1.4rem 1.6rem; }
  .bundle-picker__head input { accent-color: rgb(var(--color-button)); flex-shrink: 0; height: 2rem; margin: 0; width: 2rem; }
  .bundle-picker__titles { display: flex; flex: 1; flex-direction: column; }
  .bundle-picker__label { font-size: 1.6rem; font-weight: 700; }
  .bundle-picker__sublabel { font-size: 1.3rem; opacity: 0.75; }
  .bundle-picker__prices { display: flex; flex-direction: column; text-align: right; }
  .bundle-picker__total { font-size: 1.6rem; font-weight: 700; }
  .bundle-picker__full { font-size: 1.3rem; opacity: 0.6; }
  .bundle-picker__save { color: rgb(var(--color-button)); font-size: 1.2rem; font-weight: 700; }
  .bundle-picker__badge {
    background: rgb(var(--color-button));
    border-radius: 2rem;
    color: rgb(var(--color-button-text));
    font-size: 1.1rem;
    font-weight: 700;
    padding: 0.2rem 1rem;
    position: absolute;
    right: 1.6rem;
    top: -1.1rem;
  }
  .bundle-picker__body { display: none; padding: 0 1.6rem 1.4rem 4.8rem; }
  .bundle-picker__tier.is-active .bundle-picker__body { display: block; }
  .bundle-picker__option-name { font-size: 1.3rem; font-weight: 600; margin: 0 0 0.6rem; }
  .bundle-picker__unit { align-items: center; display: flex; gap: 1rem; margin-bottom: 0.8rem; }
  .bundle-picker__unit-label { font-size: 1.3rem; font-weight: 700; min-width: 2.4rem; }
  .bp-select { position: relative; }
  .bp-select__button {
    align-items: center;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.3);
    border-radius: 0.8rem;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 1.4rem;
    gap: 0.8rem;
    min-height: 4.4rem;
    min-width: 17rem;
    padding: 0.6rem 1.2rem;
  }
  .bp-select__button:focus-visible { outline: 0.2rem solid rgb(var(--color-button)); outline-offset: 0.2rem; }
  .bp-select__caret { border: solid currentColor; border-width: 0 0.15rem 0.15rem 0; height: 0.7rem; margin-left: auto; transform: rotate(45deg) translateY(-0.2rem); width: 0.7rem; }
  .bp-chip[hidden] { display: none; }
  .bp-chip {
    background: var(--chip, #ccc);
    border: 0.1rem solid rgba(var(--color-foreground), 0.25);
    border-radius: 0.4rem;
    flex-shrink: 0;
    height: 2rem;
    width: 2rem;
  }
  .bp-select__list {
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.2);
    border-radius: 0.8rem;
    box-shadow: 0 0.8rem 2.4rem rgba(0, 0, 0, 0.12);
    left: 0;
    max-height: 26rem;
    min-width: 100%;
    overflow-y: auto;
    padding: 0.4rem;
    position: absolute;
    top: calc(100% + 0.4rem);
    z-index: 5;
  }
  .bp-select__option { align-items: center; border-radius: 0.6rem; cursor: pointer; display: flex; font-size: 1.4rem; gap: 1rem; min-height: 4.4rem; padding: 0.6rem 1rem; }
  .bp-select__option:hover, .bp-select__option:has(input:focus-visible) { background: rgba(var(--color-foreground), 0.06); }
  .bp-select__option:has(input:checked) { font-weight: 700; }
  .bp-select__option input { height: 1px; opacity: 0; position: absolute; width: 1px; }
  .bp-select__option.is-disabled { opacity: 0.4; text-decoration: line-through; }
  .bundle-picker__perks { font-size: 1.3rem; margin: 0.4rem 0 0; opacity: 0.85; }
{%- endstyle -%}

<script>
  if (!customElements.get('bundle-picker')) {
    customElements.define(
      'bundle-picker',
      class BundlePicker extends HTMLElement {
        connectedCallback() {
          this.form = document.getElementById(this.dataset.form);
          this.tiers = [...this.querySelectorAll('[data-tier]')];
          this.tiers.forEach((tier) => {
            tier.querySelector('.bundle-picker__head input').addEventListener('change', () => this.render());
          });
          if (!this.activeTier() && this.tiers[0]) this.tiers[0].querySelector('.bundle-picker__head input').checked = true;
          this.render();

          this.querySelectorAll('[data-select]').forEach((select) => this.initSelect(select));
          this.onOutside = (e) => {
            this.querySelectorAll('[data-select]').forEach((sel) => {
              if (!sel.contains(e.target)) this.toggleSelect(sel, false);
            });
          };
          document.addEventListener('click', this.onOutside);

          // Capture phase: runs before Dawn's product-form submit handler.
          this.onSubmit = this.onSubmit.bind(this);
          document.addEventListener('submit', this.onSubmit, true);
        }

        disconnectedCallback() {
          document.removeEventListener('submit', this.onSubmit, true);
          document.removeEventListener('click', this.onOutside);
        }

        // Colour dropdown: a button showing the chosen colour chip + name,
        // opening a list of radio options (the radios hold the real state).
        initSelect(select) {
          const button = select.querySelector('.bp-select__button');
          button.addEventListener('click', () => this.toggleSelect(select, button.getAttribute('aria-expanded') !== 'true'));
          select.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              this.toggleSelect(select, false);
              button.focus();
            }
          });
          select.querySelectorAll('input[type="radio"]').forEach((input) => {
            input.addEventListener('change', () => {
              const chip = select.querySelector('[data-chip]');
              chip.style.setProperty('--chip', input.dataset.color);
              chip.hidden = !input.dataset.color;
              select.querySelector('[data-name]').textContent = input.closest('label').textContent.trim();
            });
            // Mouse click or Enter/Space picks the option and closes the list.
            input.closest('label').addEventListener('click', () => {
              setTimeout(() => {
                this.toggleSelect(select, false);
                button.focus();
              });
            });
          });
        }

        toggleSelect(select, open) {
          const button = select.querySelector('.bp-select__button');
          const list = select.querySelector('.bp-select__list');
          if (open) {
            this.querySelectorAll('[data-select]').forEach((other) => other !== select && this.toggleSelect(other, false));
          }
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
          list.hidden = !open;
          if (open) (list.querySelector('input:checked') || list.querySelector('input:not(:disabled)'))?.focus();
        }

        activeTier() {
          return this.tiers.find((t) => t.querySelector('.bundle-picker__head input').checked);
        }

        render() {
          const active = this.activeTier();
          this.tiers.forEach((t) => t.classList.toggle('is-active', t === active));
          // Lets the sticky add-to-cart bar show the bundle total.
          if (active) {
            document.dispatchEvent(
              new CustomEvent('bundle:change', { detail: { qty: Number(active.dataset.qty), total: active.dataset.totalText } })
            );
          }
        }

        // One cart line per variant, e.g. {id: white, qty: 2}, {id: black, qty: 1}.
        selectedItems() {
          const tier = this.activeTier();
          const qty = Number(tier.dataset.qty);
          const units = [...tier.querySelectorAll('[data-unit]')];
          const fallback = this.form?.querySelector('[name="id"]')?.value;
          const ids = units.length
            ? units.map((u) => u.querySelector('input:checked')?.value || fallback)
            : Array(qty).fill(fallback);
          const counts = ids.reduce((m, id) => m.set(id, (m.get(id) || 0) + 1), new Map());
          return [...counts].map(([id, quantity]) => ({ id: Number(id), quantity }));
        }

        onSubmit(event) {
          if (event.target !== this.form) return;
          event.preventDefault();
          event.stopPropagation();

          const productForm = this.form.closest('product-form');
          const button = this.form.querySelector('[type="submit"]');
          if (!button || button.getAttribute('aria-disabled') === 'true') return;
          const spinner = this.form.querySelector('.loading__spinner');
          const cart = document.querySelector('cart-drawer');

          button.setAttribute('aria-disabled', 'true');
          button.classList.add('loading');
          spinner?.classList.remove('hidden');
          productForm?.handleErrorMessage?.();

          const body = { items: this.selectedItems() };
          if (cart) {
            body.sections = cart.getSectionsToRender().map((s) => s.id);
            body.sections_url = window.location.pathname;
            cart.setActiveElement?.(document.activeElement);
          }

          fetch(`${window.routes.cart_add_url}.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(body),
          })
            .then((r) => r.json())
            .then((response) => {
              if (response.status) {
                productForm?.handleErrorMessage?.(response.description || response.message);
                return;
              }
              if (!cart) {
                window.location = window.routes.cart_url;
                return;
              }
              if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
                publish(PUB_SUB_EVENTS.cartUpdate, { source: 'bundle-picker', cartData: response });
              }
              cart.classList.remove('is-empty');
              cart.renderContents(response);
            })
            .catch(() => productForm?.handleErrorMessage?.('Something went wrong. Please try again.'))
            .finally(() => {
              button.classList.remove('loading');
              button.removeAttribute('aria-disabled');
              spinner?.classList.add('hidden');
            });
        }
      }
    );
  }
</script>
