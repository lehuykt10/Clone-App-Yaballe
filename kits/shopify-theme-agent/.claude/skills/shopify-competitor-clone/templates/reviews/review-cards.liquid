{%- comment -%}
  Kit review cards: "What our customers say" with an auto-computed rating pill and
  photo cards (photo left, stars, quote, name, country, color/size, source).
  Data: the product's real Customer review entries (metafield custom.reviews) and, if set,
  the sourced outside rating (snippet external-rating). Hidden until one of them exists.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
  assign reviews = p.metafields.custom.reviews.value
  assign count = 0
  assign total = 0
  for r in reviews
    assign count = count | plus: 1
    assign total = total | plus: r.rating.value
  endfor
  assign has_ext = false
  if p.metafields.custom.ext_rating.value != blank and p.metafields.custom.ext_rating_count.value != blank and p.metafields.custom.ext_rating_source.value != blank
    assign has_ext = true
  endif
-%}
{%- if count > 0 or has_ext -%}
  {%- liquid
    if count > 0
      assign avg_x10 = total | times: 10 | divided_by: count
      assign avg_int = avg_x10 | divided_by: 10
      assign avg_dec = avg_x10 | modulo: 10
      assign full = total | times: 1.0 | divided_by: count | round
    endif
  -%}
  <div id="reviews" class="rvc color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width rvc__inner section-{{ section.id }}-padding">
      <h2 class="rvc__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- if count > 0 -%}
      <div class="rvc__pill">
        <span class="rvc__score">{{ avg_int }}.{{ avg_dec }} stars rating</span>
        <span class="rvc__meta"><span class="rvc__pillstars" aria-hidden="true">{%- for i in (1..5) -%}{%- if i <= full -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span><span>Based on {{ count }} review{% if count > 1 %}s{% endif %} on {{ shop.name | escape }}</span></span>
      </div>
      {%- endif -%}
      {%- if has_ext -%}<div class="rvc__ext">{% render 'external-rating', product: p %}</div>{%- endif -%}
      {%- if count > 0 -%}
      <div class="rvc__grid">
        {%- for r in reviews limit: section.settings.max_reviews -%}
          {%- assign has_photo = false -%}
          {%- if r.photo.value != blank -%}{%- assign has_photo = true -%}{%- endif -%}
          <article class="rvc__card{% unless has_photo %} rvc__card--text{% endunless %}">
            {%- if has_photo -%}
              <div class="rvc__photo">
                {{ r.photo.value | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,400,600', sizes: '(min-width: 990px) 15vw, 38vw', alt: r.author.value }}
              </div>
            {%- endif -%}
            <div class="rvc__body">
              <div class="rvc__stars" aria-label="{{ r.rating.value }} out of 5 stars">{%- for i in (1..5) -%}{%- if i <= r.rating.value -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</div>
              <p class="rvc__text">{{ r.body.value | escape | newline_to_br }}</p>
              <p class="rvc__who"><b>{{ r.author.value | escape }}</b>{%- if r.location.value != blank -%}<span>{{ r.location.value | escape }}</span>{%- endif -%}</p>
              <p class="rvc__src">
                {%- if r.color.value != blank -%}Color: {{ r.color.value | escape }} · {% endif -%}
                {%- if r.size.value != blank -%}Size {{ r.size.value | escape }} · {% endif -%}
                {{ r.source.value | escape }}
              </p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding:3rem 0;text-align:center;opacity:.7">
    Customer reviews: hidden on the store until real reviews are linked to this product
    (Shopify admin → Content → Metaobjects → Customer review, then Product → Metafields → Customer reviews).
  </div>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  .rvc__heading { margin: 0 0 2rem; }
  .rvc__ext { margin-top: 1.4rem; }
  .rvc__pill { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); border-radius: 99rem; padding: .6rem 2.2rem .6rem .6rem; max-width: 100%; }
  .rvc__score { background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); border-radius: 99rem; padding: .9rem 1.8rem; font-weight: 700; font-size: 1.6rem; }
  .rvc__meta { display: grid; line-height: 1.3; font-size: 1.4rem; }
  .rvc__pillstars { letter-spacing: .2rem; }
  .rvc__grid { display: grid; gap: 1.6rem; grid-template-columns: minmax(0, 1fr); margin-top: 3rem; }
  @media screen and (min-width: 990px) { .rvc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .rvc__card { display: grid; grid-template-columns: 38% minmax(0, 1fr); background: rgba(var(--color-foreground), .05); border-radius: var(--text-boxes-radius, 1.4rem); overflow: hidden; min-height: 18rem; }
  .rvc__card--text { grid-template-columns: minmax(0, 1fr); }
  .rvc__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rvc__body { padding: 1.8rem; display: grid; gap: .6rem; align-content: start; min-width: 0; }
  .rvc__stars { color: #F5B301; letter-spacing: .2rem; font-size: 1.8rem; }
  .rvc__text { margin: 0; overflow-wrap: anywhere; }
  .rvc__who { margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: 1.4rem; }
  .rvc__who span { opacity: .7; }
  .rvc__src { margin: 0; font-size: 1.2rem; opacity: .65; }
{%- endstyle -%}

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty on a product page to use that product. On the home page, choose the product." },
    { "type": "text", "id": "heading", "default": "What our customers say", "label": "Heading" },
    { "type": "select", "id": "heading_size", "default": "h1", "label": "Heading size",
      "options": [ { "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" } ] },
    { "type": "range", "id": "max_reviews", "min": 2, "max": 20, "step": 1, "default": 8, "label": "Reviews to show" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48, "label": "Bottom padding" }
  ],
  "presets": [ { "name": "Customer reviews" } ]
}
{% endschema %}
