{%- assign sz_lang = template.suffix | split: '-' | last -%}{%- if request.locale.iso_code == 'es' -%}{%- assign sz_lang = 'es' -%}{%- endif -%}
{%- liquid
  assign t_announcement = section.settings.announcement
  assign t_marquee = section.settings.marquee
  assign t_h = 'HRS'
  assign t_m = 'MINS'
  assign t_s = 'SECS'
  if sz_lang == 'es'
    assign t_announcement = section.settings.announcement_es | default: section.settings.announcement
    assign t_marquee = section.settings.marquee_es | default: section.settings.marquee
    assign t_h = 'HRS'
    assign t_m = 'MIN'
    assign t_s = 'SEG'
  endif
-%}
{%- if section.settings.show_announcement -%}
<div class="promo">
  <div class="wrap">
    <b>{{ t_announcement | escape }}</b>
    {%- if section.settings.show_countdown -%}
    <div class="clock" aria-hidden="true">
      <span><i data-cd-h>00</i>{{ t_h }}</span><em>:</em>
      <span><i data-cd-m>00</i>{{ t_m }}</span><em>:</em>
      <span><i data-cd-s>00</i>{{ t_s }}</span>
    </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
{%- if t_marquee != blank -%}
  {%- assign items = t_marquee | split: '|' -%}
  <div class="marquee" aria-hidden="true"><div>
    {%- for i in (1..2) -%}{%- for t in items -%}<span>{{ t | strip | escape }}</span>{%- endfor -%}{%- endfor -%}
  </div></div>
{%- endif -%}
<header class="head">
  <div class="wrap">
    <button class="icon-btn" id="menuBtn" data-open="#menu" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name }}
      {%- else -%}
        <b style="font-family:var(--font-display);font-size:28px;color:var(--ink)">{{ shop.name }}</b>
      {%- endif -%}
    </a>
    <nav class="desk" aria-label="Main">
      {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
    </nav>
    <a class="icon-btn" href="{{ routes.cart_url }}" data-open="#cart" aria-label="Open cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span class="badge" id="cartCount"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>
<style>.logo img{display:block;height:{{ settings.logo_height }}px;width:auto}</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "RAINY SEASON SALE ENDS IN" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown (resets at midnight)", "default": true },
    { "type": "text", "id": "marquee", "label": "Scrolling text", "info": "Separate items with |", "default": "FREE SHIPPING | BOOTS INCLUDED | 3 COLORS | 30-DAY FIT GUARANTEE | XS TO XXL" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Spanish pages", "info": "Shown on templates whose name ends in -es, e.g. product.glow-wings-es." },
    { "type": "text", "id": "announcement_es", "label": "Announcement (Spanish)", "default": "OFERTAS NAVIDEÑAS TERMINAN EN" },
    { "type": "text", "id": "marquee_es", "label": "Scrolling text (Spanish)", "info": "Separate items with |", "default": "ENVÍO GRATIS A TODO EL MUNDO | IMPUESTOS Y ARANCELES INCLUIDOS | GARANTÍA DE 30 DÍAS | PIDE ANTES DEL 5 DE DIC. PARA RECIBIR EN NAVIDAD (EE. UU.)" }
  ]
}
{% endschema %}
