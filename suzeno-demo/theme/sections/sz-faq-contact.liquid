<section class="block faq" id="faq">
  <div class="wrap grid-2">
    <div>
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="acc">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}><summary>{{ block.settings.question | escape }}</summary><div class="ans rte">{{ block.settings.answer }}</div></details>
        {%- endfor -%}
      </div>
    </div>
    <div style="display:grid;gap:18px;align-content:start">
      {%- if section.settings.show_contact -%}
        {%- form 'contact', class: 'card', id: 'SzContactForm' -%}
          <h3>{{ section.settings.label_contact | default: "Contact us" | escape }}</h3>
          <p>{{ section.settings.label_contact_text | default: "Questions about your order? Send us a message and we'll reply within 1 business day." | escape }}</p>
          {%- if form.posted_successfully? -%}<p class="status">{{ section.settings.label_thanks | default: "Thanks! We got your message." | escape }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="errors">{{ form.errors | default_errors }}</p>{%- endif -%}
          <label class="sr" for="SzName">{{ section.settings.label_name | default: "Name" | escape }}</label><input class="field" id="SzName" name="contact[name]" placeholder="{{ section.settings.label_name | default: "Name" | escape }}" autocomplete="name">
          <label class="sr" for="SzEmail">{{ section.settings.label_email | default: "Email" | escape }}</label><input class="field" id="SzEmail" type="email" name="contact[email]" placeholder="{{ section.settings.label_email | default: "Email" | escape }}" required autocomplete="email">
          <label class="sr" for="SzOrder">{{ section.settings.label_order | default: "Order number (optional)" | escape }}</label><input class="field" id="SzOrder" name="contact[order]" placeholder="{{ section.settings.label_order | default: "Order number (optional)" | escape }}">
          <label class="sr" for="SzMsg">{{ section.settings.label_message | default: "Your message" | escape }}</label><textarea class="field" id="SzMsg" name="contact[body]" placeholder="{{ section.settings.label_message | default: "Your message" | escape }}" required></textarea>
          <button class="btn sun" type="submit">{{ section.settings.label_send | default: "Send message" | escape }}</button>
          {%- if settings.support_email != blank -%}<p class="note">{{ section.settings.label_email_us | default: "Or email us at" | escape }} <b class="mail">{{ settings.support_email }}</b></p>{%- endif -%}
        {%- endform -%}
      {%- endif -%}
      {%- if section.settings.tracking_url != blank -%}
        <form class="card" onsubmit="event.preventDefault();var v=this.querySelector('input').value.trim();if(v)window.open({{ section.settings.tracking_url | json }}+encodeURIComponent(v),'_blank','noopener');">
          <h3>{{ section.settings.label_track | default: "Track your order" | escape }}</h3>
          <label class="sr" for="SzTrack">{{ section.settings.label_tracking_number | default: "Tracking number" | escape }}</label><input class="field" id="SzTrack" placeholder="{{ section.settings.label_tracking_number | default: "Tracking number" | escape }}" required>
          <button class="btn dark" type="submit">{{ section.settings.label_track_button | default: "Track package" | escape }}</button>
        </form>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ and contact",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "checkbox", "id": "show_contact", "label": "Show contact form", "default": true },
    { "type": "text", "id": "tracking_url", "label": "Tracking link", "info": "The tracking number is added to the end. Leave empty to hide.", "default": "https://t.17track.net/en#nums=" },
    { "type": "header", "content": "Form wording" },
    { "type": "text", "id": "label_contact", "label": "Contact heading", "default": "Contact us" },
    { "type": "text", "id": "label_contact_text", "label": "Contact text", "default": "Questions about your order? Send us a message and we'll reply within 1 business day." },
    { "type": "text", "id": "label_name", "label": "Name field", "default": "Name" },
    { "type": "text", "id": "label_email", "label": "Email field", "default": "Email" },
    { "type": "text", "id": "label_order", "label": "Order number field", "default": "Order number (optional)" },
    { "type": "text", "id": "label_message", "label": "Message field", "default": "Your message" },
    { "type": "text", "id": "label_send", "label": "Send button", "default": "Send message" },
    { "type": "text", "id": "label_thanks", "label": "Sent message", "default": "Thanks! We got your message." },
    { "type": "text", "id": "label_email_us", "label": "Email line", "default": "Or email us at" },
    { "type": "text", "id": "label_track", "label": "Tracking heading", "default": "Track your order" },
    { "type": "text", "id": "label_tracking_number", "label": "Tracking number field", "default": "Tracking number" },
    { "type": "text", "id": "label_track_button", "label": "Tracking button", "default": "Track package" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ],
  "presets": [ { "name": "FAQ and contact", "blocks": [ { "type": "question" }, { "type": "question" } ] } ]
}
{% endschema %}
