<section class="block" id="{{ section.settings.anchor | default: 'shop' | handleize }}">
  <div class="wrap pgrid-wrap">
    <div class="pgrid-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="grid-cards">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            <div {{ block.shopify_attributes }}>{% render 'product-card', product: block.settings.product, badge: block.settings.badge, second_image: true %}</div>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, second_image: true %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}<div class="pcard"><div class="pimg">{{ 'product-1' | placeholder_svg_tag: 'ph' }}</div><b>Product</b></div>{%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="pgrid-more" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor for links", "info": "Buttons can link to #this-anchor.", "default": "shop" },
    { "type": "text", "id": "eyebrow", "label": "Small line" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our pet gifts" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used only when no products are added as blocks." },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products from collection", "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "badge", "label": "Badge", "info": "For example New or Christmas. Leave empty to hide." }
    ] }
  ],
  "presets": [ { "name": "Product grid" } ]
}
{% endschema %}
