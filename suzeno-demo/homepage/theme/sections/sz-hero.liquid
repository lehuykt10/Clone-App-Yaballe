<section class="hero" aria-label="{{ section.settings.heading | escape }}">
  <div class="hero-media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600,2000', sizes: '100vw', alt: section.settings.image.alt | default: '' }}
    {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ph' }}{%- endif -%}
  </div>
  <div class="hero-shade" style="--shade:{{ section.settings.shade | divided_by: 100.0 }}"></div>
  <div class="wrap hero-copy">
    {%- if section.settings.eyebrow != blank -%}<span class="hero-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="hero-actions">
      {%- if section.settings.button_label != blank -%}<a class="hero-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
      {%- if section.settings.button2_label != blank -%}<a class="hero-btn ghost" href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "shade", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Dark overlay", "default": 45 },
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Holiday gift shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gifts for the pets who make us smile" },
    { "type": "text", "id": "text", "label": "Text", "default": "Cozy, clever and a little magical. Free worldwide shipping." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [ { "name": "Hero banner" } ]
}
{% endschema %}
