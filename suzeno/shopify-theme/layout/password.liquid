<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Nunito+Sans:wght@400;700&display=swap">
  <style>:root{--sky-deep:{{ settings.color_brand }};--ink:{{ settings.color_ink }};--paper:{{ settings.color_paper }};--line:#e7dfd2;--font-display:"Quicksand",sans-serif;--font-body:"Nunito Sans",sans-serif;--pill:40px}</style>
  {{ 'suzeno.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="wrap narrow page-pad">{{ content_for_layout }}</main>
</body>
</html>
