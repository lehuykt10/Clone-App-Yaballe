<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_paper }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{%- endif -%}
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap">
  <style>
    :root{
      --sky:{{ settings.color_brand_tint }};
      --sky-deep:{{ settings.color_brand }};
      --sky-mist:{{ settings.color_blush }};
      --sun:{{ settings.color_star }};
      --sun-soft:{{ settings.color_sand }};
      --cta:{{ settings.color_button }};
      --cta-ink:#ffffff;
      --ink:{{ settings.color_ink }};
      --ink-soft:{{ settings.color_ink_soft }};
      --line:#e7dfd2;
      --paper:{{ settings.color_paper }};
      --night:{{ settings.color_pine }};
      --ok:#2f9e6a;
      --sale:#d64545;
      --font-display:"Quicksand","Nunito Sans",system-ui,sans-serif;
      --font-body:"Nunito Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
      --r-sm:12px; --r-md:14px; --r-lg:14px; --pill:40px;
      --gutter-l:max(16px, env(safe-area-inset-left, 0px));
      --gutter-r:max(16px, env(safe-area-inset-right, 0px));
    }
  </style>
  {{ 'suzeno.css' | asset_url | stylesheet_tag }}
  <script>
    window.SZ = {
      moneyFormat: {{ shop.money_format | json }},
      routes: { cartAdd: {{ routes.cart_add_url | json }}, cart: {{ routes.cart_url | json }}, cartChange: {{ routes.cart_change_url | json }}, root: {{ routes.root_url | json }} }
    };
  </script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="sr" href="#MainContent">Skip to content</a>
  {% section 'header' %}
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  <div class="toast" id="toast" role="status"></div>
  <script src="{{ 'suzeno.js' | asset_url }}" defer></script>
</body>
</html>
