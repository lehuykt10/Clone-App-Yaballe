<div class="wrap narrow page-pad">
  <h1 class="page-title">Reset your password</h1>
  {%- form 'reset_customer_password', class: 'form-grid' -%}
    {%- if form.errors -%}<p class="errors">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label for="ResetPass">New password</label><input class="field" type="password" name="customer[password]" id="ResetPass" autocomplete="new-password">
    <label for="ResetPass2">Confirm password</label><input class="field" type="password" name="customer[password_confirmation]" id="ResetPass2" autocomplete="new-password">
    <button class="btn dark" type="submit">Reset password</button>
  {%- endform -%}
</div>
