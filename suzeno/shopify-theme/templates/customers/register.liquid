<div class="wrap narrow page-pad">
  <h1 class="page-title">Create account</h1>
  {%- form 'create_customer', class: 'form-grid' -%}
    {%- if form.errors -%}<p class="errors">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label for="RegFirst">First name</label><input class="field" name="customer[first_name]" id="RegFirst" autocomplete="given-name">
    <label for="RegLast">Last name</label><input class="field" name="customer[last_name]" id="RegLast" autocomplete="family-name">
    <label for="RegEmail">Email</label><input class="field" type="email" name="customer[email]" id="RegEmail" autocomplete="email" required>
    <label for="RegPassword">Password</label><input class="field" type="password" name="customer[password]" id="RegPassword" autocomplete="new-password" required>
    <button class="btn dark" type="submit">Create account</button>
  {%- endform -%}
</div>
