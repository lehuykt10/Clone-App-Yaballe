{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your gift card – {{ shop.name }}</title>
  {{ 'suzeno.css' | asset_url | stylesheet_tag }}
  <style>:root{--sky-deep:{{ settings.color_brand }};--ink:{{ settings.color_ink }};--paper:{{ settings.color_paper }};--line:#e7dfd2;--pill:40px}</style>
  {{ content_for_header }}
</head>
<body>
  <main class="wrap narrow page-pad" style="text-align:center;display:grid;gap:14px">
    <h1 class="page-title">Your {{ gift_card.initial_value | money }} gift card</h1>
    {%- if gift_card.expired or gift_card.enabled == false -%}<p class="notice">This gift card is no longer active.</p>{%- endif -%}
    <p>Balance: <b>{{ gift_card.balance | money }}</b></p>
    <p class="mail" style="font-size:22px;font-weight:800;letter-spacing:.1em">{{ gift_card.code | format_code }}</p>
    {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}">Add to Apple Wallet</a>{%- endif -%}
    <a class="cta" href="{{ shop.url }}" style="text-decoration:none">Start shopping</a>
  </main>
</body>
</html>
