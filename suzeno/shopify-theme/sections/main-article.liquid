<article class="wrap narrow page-pad">
  {%- if article.image -%}<div style="border-radius:var(--r-lg);overflow:hidden;margin-bottom:20px">{{ article.image | image_url: width: 1200 | image_tag: loading: 'eager' }}</div>{%- endif -%}
  <h1 class="page-title">{{ article.title | escape }}</h1>
  <p class="note" style="text-align:left;margin-bottom:16px">{{ article.published_at | date: '%B %-d, %Y' }}</p>
  <div class="rte">{{ article.content }}</div>
</article>
{% schema %}{ "name": "Article", "settings": [] }{% endschema %}
