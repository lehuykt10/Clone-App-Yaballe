<div class="wrap page-pad">
  <h1 class="page-title">{{ collection.title | escape }}</h1>
  {%- if collection.description != blank -%}<div class="rte" style="margin-bottom:20px">{{ collection.description }}</div>{%- endif -%}
  {%- paginate collection.products by 24 -%}
    <div class="grid-cards">
      {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- else -%}<p class="notice">No products here yet.</p>{%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}{ "name": "Collection", "settings": [] }{% endschema %}
