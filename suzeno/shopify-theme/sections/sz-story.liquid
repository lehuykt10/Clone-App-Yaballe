{%- capture circle -%}<svg viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true"><path d="M18 46 C14 18 70 6 112 8 C160 10 192 24 188 44 C184 66 130 76 90 74 C46 72 12 62 16 40 C19 26 40 16 70 12"/></svg>{%- endcapture -%}
<section class="block">
  <div class="wrap story">
    <div class="media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1200', sizes: '(min-width: 860px) 50vw, 100vw', style: 'width:100%;height:100%;object-fit:cover' }}
      {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ph' }}{%- endif -%}
    </div>
    <div class="txt">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}{% if section.settings.circled != blank %} <span class="circle" style="color:var(--sky-deep)">{{ section.settings.circled | escape }}{{ circle }}</span>{% endif %}</h2>
      <div class="rte" style="font-size:16px">{{ section.settings.text }}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Why dog parents switch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your dog stays dry. Your floors stay" },
    { "type": "text", "id": "circled", "label": "Circled word", "default": "clean" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the story of the problem your product solves.</p>" }
  ],
  "presets": [ { "name": "Image with story" } ]
}
{% endschema %}
