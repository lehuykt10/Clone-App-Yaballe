<section class="block sizing" id="size-guide">
  <div class="wrap">
    <div style="text-align:center;display:grid;gap:8px"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div>
    <div class="unit-toggle" role="group" aria-label="Units">
      <button type="button" data-unit="in" aria-pressed="true">Inches / lb</button>
      <button type="button" data-unit="cm" aria-pressed="false">cm / kg</button>
    </div>
    <div class="table-scroll"><table data-size-table></table></div>
    <div class="measure">
      <div><b>Back length</b>From the base of the collar to the base of the tail.</div>
      <div><b>Chest</b>Around the widest part of the ribcage, just behind the front legs.</div>
      <div><b>Neck</b>Around the neck where the collar sits. Leave room for two fingers.</div>
    </div>
    {%- if section.settings.tip != blank -%}<p class="tip">{{ section.settings.tip | escape }}</p>{%- endif -%}
  </div>
  <script type="application/json" data-size-json>
    {"sizes": {{ section.settings.sizes | split: ',' | json }}, "back": {{ section.settings.back | split: ',' | json }}, "chest": {{ section.settings.chest | split: ',' | json }}, "neck": {{ section.settings.neck | split: ',' | json }}, "kg": {{ section.settings.weight_kg | split: ',' | json }}}
  </script>
  <script>
    (function () {
      var sec = document.currentScript.closest('section');
      var d = JSON.parse(sec.querySelector('[data-size-json]').textContent);
      var t = sec.querySelector('[data-size-table]'), unit = 'in';
      var r1 = function (v) { return Math.round(v * 10) / 10; };
      function len(v) { v = parseFloat(v); return unit === 'in' ? r1(v / 2.54) : v; }
      function wt(s) { var p = String(s).split('-').map(parseFloat); return unit === 'in' ? p.map(function (x) { return r1(x * 2.2046); }).join('–') : p.join('–'); }
      function row(label, arr, f) { return '<tr><th scope="row">' + label + '</th>' + arr.map(function (v) { return '<td>' + f(v) + '</td>'; }).join('') + '</tr>'; }
      function draw() {
        var L = unit === 'in' ? ['in', 'lb'] : ['cm', 'kg'];
        t.innerHTML = '<thead><tr><th scope="col">Size</th>' + d.sizes.map(function (s) { return '<th scope="col">' + s.trim() + '</th>'; }).join('') + '</tr></thead><tbody>' +
          row('Back length (' + L[0] + ')', d.back, len) + row('Chest (' + L[0] + ')', d.chest, len) + row('Neck (' + L[0] + ')', d.neck, len) + row('Dog weight (' + L[1] + ')', d.kg, wt) + '</tbody>';
      }
      sec.querySelectorAll('[data-unit]').forEach(function (b) {
        b.addEventListener('click', function () { unit = b.dataset.unit; sec.querySelectorAll('[data-unit]').forEach(function (x) { x.setAttribute('aria-pressed', x === b); }); draw(); });
      });
      draw();
    })();
  </script>
</section>
{% schema %}
{
  "name": "Size guide",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Find the right fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size guide" },
    { "type": "text", "id": "sizes", "label": "Sizes", "info": "Comma separated", "default": "XS,S,M,L,XL,XXL" },
    { "type": "text", "id": "back", "label": "Back length in cm", "default": "20,25,30,35,40,45" },
    { "type": "text", "id": "chest", "label": "Chest in cm", "default": "32,37,42,47,52,57" },
    { "type": "text", "id": "neck", "label": "Neck in cm", "default": "27,29,32,35,38,41" },
    { "type": "text", "id": "weight_kg", "label": "Dog weight in kg", "info": "Ranges like 0.5-1.5, comma separated", "default": "0.5-1.5,1.5-2.5,2.5-4,4-6,6-7.5,7.5-10" },
    { "type": "text", "id": "tip", "label": "Tip", "default": "Between sizes? Pick the bigger one. Back length matters most for a full-body coat." }
  ],
  "presets": [ { "name": "Size guide" } ]
}
{% endschema %}
