{%- liquid
  assign convertible = false
  for block in section.blocks
    if block.settings.unit == 'length' or block.settings.unit == 'weight'
      assign convertible = true
    endif
  endfor
-%}
<section class="block sizing" id="size-guide">
  <div class="wrap">
    <div style="text-align:center;display:grid;gap:8px">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<div class="rte" style="max-width:60ch;justify-self:center">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div style="max-width:820px;width:100%;justify-self:center;border-radius:var(--r-lg);overflow:hidden">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,800,1200', sizes: '(min-width: 860px) 820px, 100vw' }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      {%- if convertible -%}
      <div class="unit-toggle" role="group" aria-label="Units">
        <button type="button" data-unit="in" aria-pressed="true">Inches / lb</button>
        <button type="button" data-unit="cm" aria-pressed="false">cm / kg</button>
      </div>
      {%- endif -%}
      <div class="table-scroll">
        <table>
          <thead><tr><th scope="col">{{ section.settings.first_col | escape }}</th>
            {%- assign sizes = section.settings.sizes | split: ',' -%}
            {%- for s in sizes -%}<th scope="col">{{ s | strip | escape }}</th>{%- endfor -%}
          </tr></thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- assign vals = block.settings.values | split: ',' -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label | escape }}{% if block.settings.unit == 'length' %} <span data-u-len>(in)</span>{% elsif block.settings.unit == 'weight' %} <span data-u-wt>(lb)</span>{% endif %}</th>
                {%- for v in vals -%}
                  <td{% if block.settings.unit != 'text' %} data-{{ block.settings.unit }}="{{ v | strip | escape }}"{% endif %}>{{ v | strip | escape }}</td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
    {%- if section.settings.measure != blank -%}<div class="tip" style="background:var(--paper);border:1px dashed var(--sky)"><div class="rte">{{ section.settings.measure }}</div></div>{%- endif -%}
    {%- if section.settings.tip != blank -%}<p class="tip">{{ section.settings.tip | escape }}</p>{%- endif -%}
  </div>
  {%- if convertible -%}
  <script>
    (function () {
      var sec = document.currentScript.closest('section');
      var r1 = function (v) { return Math.round(v * 10) / 10; };
      function conv(str, f) { return String(str).split('-').map(function (x) { return r1(parseFloat(x) * f); }).join('–'); }
      function draw(unit) {
        sec.querySelectorAll('[data-length]').forEach(function (td) { td.textContent = unit === 'in' ? conv(td.dataset.length, 1 / 2.54) : td.dataset.length.replace('-', '–'); });
        sec.querySelectorAll('[data-weight]').forEach(function (td) { td.textContent = unit === 'in' ? conv(td.dataset.weight, 2.2046) : td.dataset.weight.replace('-', '–'); });
        sec.querySelectorAll('[data-u-len]').forEach(function (s) { s.textContent = unit === 'in' ? '(in)' : '(cm)'; });
        sec.querySelectorAll('[data-u-wt]').forEach(function (s) { s.textContent = unit === 'in' ? '(lb)' : '(kg)'; });
      }
      sec.querySelectorAll('[data-unit]').forEach(function (b) {
        b.addEventListener('click', function () { sec.querySelectorAll('[data-unit]').forEach(function (x) { x.setAttribute('aria-pressed', x === b); }); draw(b.dataset.unit); });
      });
      draw('in');
    })();
  </script>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Size guide",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Find the right fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size guide" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Size chart image" },
    { "type": "text", "id": "first_col", "label": "First column title", "default": "Size" },
    { "type": "text", "id": "sizes", "label": "Sizes", "info": "Comma separated, e.g. XS,S,M,L", "default": "S,M,L" },
    { "type": "richtext", "id": "measure", "label": "How to measure" },
    { "type": "text", "id": "tip", "label": "Tip", "default": "Between sizes? Pick the bigger one." }
  ],
  "blocks": [
    { "type": "row", "name": "Table row", "settings": [
      { "type": "text", "id": "label", "label": "Row label", "default": "Chest" },
      { "type": "text", "id": "values", "label": "Values", "info": "Comma separated, one per size. Use cm or kg, ranges like 2.5-4.", "default": "40,45,50" },
      { "type": "select", "id": "unit", "label": "Values are", "default": "length", "options": [
        { "value": "length", "label": "Length in cm (shows inches too)" },
        { "value": "weight", "label": "Weight in kg (shows lb too)" },
        { "value": "text", "label": "Plain text" }
      ] }
    ] }
  ],
  "presets": [ { "name": "Size guide", "blocks": [ { "type": "row" } ] } ]
}
{% endschema %}
