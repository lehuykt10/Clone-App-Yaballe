<div style="text-align:center;display:grid;gap:16px">
  {%- if settings.logo != blank -%}<div style="justify-self:center">{{ settings.logo | image_url: width: 300 | image_tag: style: 'height:36px;width:auto' }}</div>{%- else -%}<h1 class="page-title">{{ shop.name }}</h1>{%- endif -%}
  <p>{{ shop.password_message | default: 'Opening soon.' }}</p>
  {%- form 'storefront_password', class: 'form-grid', style: 'justify-self:center' -%}
    {%- if form.errors -%}<p class="errors">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="sr" for="Password">Password</label>
    <input class="field" type="password" name="password" id="Password" placeholder="Store password" autocomplete="current-password">
    <button class="btn dark" type="submit">Enter</button>
  {%- endform -%}
</div>
{% schema %}{ "name": "Password", "settings": [] }{% endschema %}
