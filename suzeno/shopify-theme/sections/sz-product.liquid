{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
-%}
{%- if p == blank -%}
  <div class="wrap page-pad"><p class="notice">Choose a product for this section in the theme editor.</p></div>
{%- else -%}
{%- assign current = p.selected_or_first_available_variant -%}
<div class="wrap product" id="sz-{{ section.id }}" data-sz-product>
  <div class="gallery">
    <div class="stage">
      <div class="slides" data-slides>
        {%- for m in p.media -%}
          {%- if m.media_type == 'image' -%}
            <div class="slide" data-media-id="{{ m.id }}">
              {{ m | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400,600,800,1000,1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: m.alt | default: p.title }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="slide">{{ 'product-1' | placeholder_svg_tag: 'ph' }}</div>
        {%- endfor -%}
      </div>
      <button class="arrow prev" type="button" data-prev aria-label="Previous photo">‹</button>
      <button class="arrow next" type="button" data-next aria-label="Next photo">›</button>
    </div>
    <div class="thumbs" role="tablist" aria-label="Product photos" data-thumbs>
      {%- assign n = 0 -%}
      {%- for m in p.media -%}
        {%- if m.media_type == 'image' -%}
          <button class="thumb" type="button" data-i="{{ n }}" aria-label="Photo {{ n | plus: 1 }}">{{ m | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}</button>
          {%- assign n = n | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="info">
    {%- if section.settings.stock_line != blank -%}<div class="stock">{{ section.settings.stock_line | escape }}</div>{%- endif -%}
    {%- if section.settings.rating_text != blank -%}
      <div class="rating"><span class="stars" aria-hidden="true">★★★★★</span><span>{{ section.settings.rating_text | escape }}</span></div>
    {%- endif -%}
    <h1 class="title">{{ p.title | escape }}</h1>
    <ul class="perks">
      {%- for block in section.blocks -%}{%- if block.type == 'perk' -%}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{%- endif -%}{%- endfor -%}
    </ul>

    {%- if section.settings.notice != blank -%}<p class="notice-line">{{ section.settings.notice | escape }}</p>{%- endif -%}
    <div class="divider">{{ section.settings.bundle_heading | upcase | escape }}</div>
    {%- if section.settings.show_timer -%}<div class="timer-pill">Hurry! Offer expires in: <b data-cd-all>00:00:00</b> ⏰</div>{%- endif -%}

    <div class="bundles" data-bundles role="radiogroup" aria-label="Choose a bundle"></div>
    {%- if section.settings.show_size_link -%}<a class="size-link" href="#size-guide">📏 Not sure which size? Open the size guide</a>{%- endif -%}

    <button class="cta" type="button" data-add>
      {%- if current.available -%}Add to cart{%- else -%}Sold out{%- endif -%}<small data-add-sub></small>
    </button>
    <p class="err-msg" data-err hidden></p>

    {%- capture reviews -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="mini" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              {{ block.settings.photo | image_url: width: 120, height: 120, crop: 'center' | image_tag: class: 'avatar', alt: block.settings.name, style: 'object-fit:cover' }}
            {%- else -%}<div class="avatar">{{ block.settings.name | slice: 0 | upcase }}</div>{%- endif -%}
            <div><div class="who"><span class="stars">★★★★★</span>{{ block.settings.name | escape }}</div><p>{{ block.settings.text | escape }}</p></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if reviews != blank -%}<div class="rail">{{ reviews }}</div>{%- endif -%}

    <div class="trust">
      <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 7h11v9H2zM13 10h4l3 3v3h-7z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{{ section.settings.trust_1 | escape }}</div>
      <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>{{ section.settings.trust_2 | escape }}</div>
      <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ section.settings.trust_3 | escape }}</div>
    </div>

    <div class="acc">
      {%- if section.settings.show_description and p.description != blank -%}
        <details><summary>Description</summary><div class="ans rte">{{ p.description }}</div></details>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
          <details {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary><div class="ans rte">{{ block.settings.content }}</div></details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<div class="sticky" data-sticky>
  <div class="row">
    <span class="cur">{{ cart.currency.iso_code }}</span>
    <button class="cta" type="button" data-sticky-add>{{ section.settings.sticky_label | escape }}</button>
  </div>
</div>

<script type="application/json" data-product-json>
{"id": {{ p.id }}, "title": {{ p.title | json }}, "options": {{ p.options | json }}, "variants": [
  {%- for v in p.variants -%}
    {"id": {{ v.id }}, "title": {{ v.title | json }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "compare_at_price": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available | json }}, "featured_media": {%- if v.featured_media -%}{"id": {{ v.featured_media.id }}}{%- else -%}null{%- endif -%}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]}
</script>
<script type="application/json" data-config-json>
{
  "tiers": [
    {%- for i in (1..3) -%}
      {%- liquid
        assign qk = 'tier_' | append: i | append: '_qty'
        assign dk = 'tier_' | append: i | append: '_discount'
        assign lk = 'tier_' | append: i | append: '_label'
        assign bk = 'tier_' | append: i | append: '_badge'
      -%}
      {"qty": {{ section.settings[qk] | default: 0 }}, "off": {{ section.settings[dk] | default: 0 | times: 100 | round }}, "label": {{ section.settings[lk] | json }}, "badge": {{ section.settings[bk] | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "defaultTier": {{ section.settings.default_tier | minus: 1 }},
  "gift": {{ section.settings.gift_text | json }},
  "swatches": {{ section.settings.swatches | json }},
  "addons": [
    {%- assign first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'addon' and block.settings.product != blank -%}
        {%- assign av = block.settings.product.selected_or_first_available_variant -%}
        {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
        {"id": {{ av.id }}, "title": {{ block.settings.label | default: block.settings.product.title | json }}, "price": {{ av.price }}, "icon": {{ block.settings.icon | json }}, "available": {{ av.available | json }}}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
<script src="{{ 'sz-product.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Product landing",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty on product pages. On the home page, choose the product to feature." },
    { "type": "text", "id": "stock_line", "label": "Stripe above the title", "default": "SELLING FAST · BOOTS INCLUDED" },
    { "type": "text", "id": "rating_text", "label": "Text next to the stars", "info": "Only show a rating you can back up with real reviews. Leave empty to hide." },
    { "type": "text", "id": "notice", "label": "Notice line", "info": "For example a Christmas delivery cut-off. Leave empty to hide." },
    { "type": "header", "content": "Bundles" },
    { "type": "text", "id": "bundle_heading", "label": "Heading", "default": "Bundle & save" },
    { "type": "checkbox", "id": "show_timer", "label": "Show offer countdown", "default": true },
    { "type": "range", "id": "default_tier", "min": 1, "max": 3, "step": 1, "label": "Selected bundle", "default": 2 },
    { "type": "number", "id": "tier_1_qty", "label": "Bundle 1: quantity", "default": 1 },
    { "type": "number", "id": "tier_1_discount", "label": "Bundle 1: discount per item", "default": 0, "info": "In your store currency. Create a matching automatic discount in Shopify." },
    { "type": "text", "id": "tier_1_label", "label": "Bundle 1: label", "default": "1 Raincoat" },
    { "type": "text", "id": "tier_1_badge", "label": "Bundle 1: badge" },
    { "type": "number", "id": "tier_2_qty", "label": "Bundle 2: quantity", "default": 2 },
    { "type": "number", "id": "tier_2_discount", "label": "Bundle 2: discount per item", "default": 5 },
    { "type": "text", "id": "tier_2_label", "label": "Bundle 2: label", "default": "2 Raincoats" },
    { "type": "text", "id": "tier_2_badge", "label": "Bundle 2: badge", "default": "MOST POPULAR" },
    { "type": "number", "id": "tier_3_qty", "label": "Bundle 3: quantity", "default": 3, "info": "0 hides this bundle." },
    { "type": "number", "id": "tier_3_discount", "label": "Bundle 3: discount per item", "default": 7 },
    { "type": "text", "id": "tier_3_label", "label": "Bundle 3: label", "default": "3 Raincoats" },
    { "type": "text", "id": "tier_3_badge", "label": "Bundle 3: badge", "default": "BEST VALUE" },
    { "type": "text", "id": "gift_text", "label": "Gift line under each bundle", "info": "Leave empty to hide." },
    { "type": "textarea", "id": "swatches", "label": "Color swatches", "info": "One per line: Color name:#hex", "default": "Sky Blue:#9cc3ea\nCarrot Orange:#f47b20\nDino Green:#7a9a4a" },
    { "type": "checkbox", "id": "show_size_link", "label": "Show size guide link", "default": true },
    { "type": "header", "content": "Trust and details" },
    { "type": "text", "id": "trust_1", "label": "Trust badge 1", "default": "Free shipping" },
    { "type": "text", "id": "trust_2", "label": "Trust badge 2", "default": "Secure checkout" },
    { "type": "text", "id": "trust_3", "label": "Trust badge 3", "default": "30-day fit guarantee" },
    { "type": "checkbox", "id": "show_description", "label": "Show product description", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Sticky button label", "default": "Add to cart" }
  ],
  "blocks": [
    { "type": "perk", "name": "Perk", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Short benefit" } ] },
    { "type": "addon", "name": "Add-on product", "limit": 3, "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🛡️" }
    ] },
    { "type": "review", "name": "Review", "settings": [
      { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" },
      { "type": "textarea", "id": "text", "label": "Review", "info": "Use real customer reviews only." },
      { "type": "image_picker", "id": "photo", "label": "Photo" }
    ] },
    { "type": "accordion", "name": "Accordion", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Title" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Content</p>" }
    ] }
  ],
  "presets": [ { "name": "Product landing" } ]
}
{% endschema %}
