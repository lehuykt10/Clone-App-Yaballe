<a class="pcard" href="{{ product.url }}">
  <div class="pimg">
    {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 860px) 25vw, 50vw' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'ph' }}{%- endif -%}
  </div>
  <b>{{ product.title | escape }}</b>
  <span class="pp">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span>
</a>
